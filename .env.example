# Local credentials template.
#
# Copy this file to .env and fill in your own values:
#     cp .env.example .env
# .env is listed in .gitignore, so it is never committed or pushed.
# Never put a real password here, and never paste one into the chat.

# Sketchfab API token, from https://sketchfab.com/settings/password
# (Account settings > Password & API > API token). Use the token instead of
# your account password - Sketchfab does not allow scripted password logins.
SKETCHFAB_API_TOKEN=

# Only needed by tools that ask for the account address.
SKETCHFAB_EMAIL=

# Nothing in this file is required to build or run the game; models are
# committed under models/ and imported by Godot.
